# Environment Configuration — Thesis Experiment Runner
# Copy this file to .env and fill in your keys before running experiments.

# =============================================================================
# LLM API Keys (at least one is required)
# =============================================================================

# Google Gemini (recommended — generous free tier, used for orchestration)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (optional, used as coding model for high-quality runs)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# LLM Model Selection
# =============================================================================
# Controls which model handles each task type.

# Set to false to use cloud models (Gemini/Anthropic) instead of local Ollama
PREFER_OLLAMA=false

# Primary coding model — generates application code
# Options: "sonnet" (Claude Sonnet), "gemini-flash", "llama3.1" (Ollama)
LLM_BEST_CODING_MODEL=gemini-flash

# Orchestration model — FSM state transitions, planning
LLM_UNIVERSAL_MODEL=gemini-flash

# Fast utility model — commit names, metadata
LLM_ULTRA_FAST_MODEL=gemini-flash-lite

# Vision model — UI analysis (optional)
LLM_VISION_MODEL=gemini-flash

# =============================================================================
# Ollama (Optional — for local LLM-based prompt generation)
# =============================================================================
# Only required if PREFER_OLLAMA=true or using Ollama for prompt auto-generation
# OLLAMA_HOST=http://localhost:11434
# PROMPT_GENERATION_MODEL=llama3.1
